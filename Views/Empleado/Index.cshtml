@model IEnumerable<tarea2_clientes.Models.EmpleadoModel>

@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Nuevo empleado</a>
</p>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Cargo)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Turno)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(model => item.Nombre)</td>
                    <td>@Html.DisplayFor(model => item.Cargo)</td>
                    <td>@Html.DisplayFor(model => item.Email)</td>
                    <td>@Html.DisplayFor(model => item.Turno)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.EmpleadoId">Detalles</a> |
                        <a asp-action="Edit" asp-route-id="@item.EmpleadoId">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.EmpleadoId">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
